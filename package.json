    "deploy:worker": "npm run build:worker && wrangler deploy"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "wrangler": "^4.161.0"
  },
  "keywords": [
    "расписание",
    "колледж",
    "кпк",
    "mstimetables"
  ],
